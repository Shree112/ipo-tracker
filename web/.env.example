# Copy to .env.local for local runs. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# Supabase -> Connect -> Transaction pooler (port 6543) is the right one for
# Vercel's serverless functions. Same password as the Python side.
DATABASE_URL=

# Supabase -> Project Settings -> API: the project URL and the anon (public)
# key. Used on the server only, for Google sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Your Google account's email. It's approved and made admin on first sign-in;
# everyone else waits for you to approve them at /admin.
ADMIN_EMAIL=
# Most approved accounts at once (you included).
MAX_USERS=100

# Signs the Applied / Skip buttons in the digest email. Any long random
# string; must be the SAME value here and in the GitHub Actions secret.
LINK_SECRET=

# Local testing only - ignored on Vercel. Skips Google and signs you in as
# this account (it must exist in app_users).
# ALLOW_DEV_AUTH=1
# DEV_AUTH_ID=
# DEV_AUTH_EMAIL=
