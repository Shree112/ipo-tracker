# Copy to .env.local for local runs. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# Supabase -> Connect -> Transaction pooler (port 6543) is the right one for
# Vercel's serverless functions. Same password as the Python side.
DATABASE_URL=

# The password you type once on the login page. Long and random is fine -
# the browser remembers it for 90 days.
SITE_PASSWORD=
