# Copy to .env.local for local runs. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# Supabase -> Connect -> Transaction pooler (port 6543) is the right one for
# Vercel's serverless functions. Same password as the Python side.
DATABASE_URL=

# Supabase -> Project Settings -> API: the project URL and the anon (public)
# key. Used on the server only, for Google sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Your Google account's email. It's approved and made admin on first sign-in;
# everyone else waits for you to approve them at /admin.
ADMIN_EMAIL=
# Most approved accounts at once (you included).
MAX_USERS=100

# Signs the Applied / Skip buttons in the digest email. Any long random
# string; must be the SAME value here and in the GitHub Actions secret.
LINK_SECRET=

# Local testing only - ignored on Vercel. Skips Google and signs you in as
# this account (it must exist in app_users).
# ALLOW_DEV_AUTH=1
# DEV_AUTH_ID=
# DEV_AUTH_EMAIL=

# "Ask about this IPO": a free key from console.groq.com (open-source models).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional web search for those answers: free key from app.tavily.com
# (1,000 searches a month, no card). Without it, answers use the prospectus only.
TAVILY_API_KEY=

# Telegram alerts: from @BotFather. The webhook secret is any long random
# string; SITE_URL is the site's public address (used to register the webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SITE_URL=https://ipo-tracker-teal.vercel.app

# The schedule (supabase_cron.sql). Supabase calls /api/cron/... with this as
# a Bearer token - any long random string, the SAME value in Supabase Vault.
CRON_SECRET=
# Lets /api/cron/refresh|live|chatter start the GitHub workflows. A
# fine-grained token: this repository only, permission "Actions: Read and write".
GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=Shree112/ipo-tracker
