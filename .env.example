# ---- Supabase REST / client API ----------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://wvxahfuyxrqpdaokyxub.supabase.co

# service_role key, NOT anon. The backfill writes, so it needs to
# bypass row-level security. Treat this like a password.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Postgres connection -----------------------------------
# Dashboard -> Connect (top of the page) -> copy the string verbatim.
#
# Pick ONE and paste it below:
#
#   Session pooler   - use this if the direct string fails to resolve.
#                      Works on IPv4-only networks, which most home
#                      connections in India are.
#     postgresql://postgres.wvxahfuyxrqpdaokyxub:[PASSWORD]@[POOLER-HOST]:5432/postgres
#
#   Direct           - cleanest for schema migrations and long scripts,
#                      but needs IPv6 (or the IPv4 add-on).
#     postgresql://postgres:[PASSWORD]@db.wvxahfuyxrqpdaokyxub.supabase.co:5432/postgres
#
# Start with Session pooler. If apply_schema.py connects, you're done.
# [PASSWORD] is the database password you set when creating the project -
# not the service_role key. Reset it under Settings -> Database if lost.
#
# If the password contains @ : / ? # or %, percent-encode it
# (@ becomes %40, # becomes %23) or the URL will parse wrong.
DATABASE_URL=

# ---- Scraper politeness ------------------------------------
# One polite pass per source per run. Don't lower these.
REQUEST_DELAY_SECONDS=2.5
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=ipo-tracker/0.1 (personal research project)

# ---- Backfill range ----------------------------------------
BACKFILL_YEAR_FROM=2019
BACKFILL_YEAR_TO=2026

# ---- Digest email (Resend) ---------------------------------
# resend.com -> sign up WITH THE SAME ADDRESS AS DIGEST_TO -> API Keys.
# Without a verified domain, Resend's test sender (onboarding@resend.dev)
# can only deliver to the address you signed up with - fine for a
# personal digest.
RESEND_API_KEY=
DIGEST_TO=ahuja.shree31@gmail.com
DIGEST_FROM=IPO Copilot <onboarding@resend.dev>

# ---- Web page ----
# The Vercel address; when set, digest cards link to /issue/<slug> there.
SITE_URL=
